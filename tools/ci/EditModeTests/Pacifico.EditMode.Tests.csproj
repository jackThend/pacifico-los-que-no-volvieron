<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Arnés de tests fuera de Unity: compila Pacifico.Core, Pacifico.Runtime
    (contra los stubs de tools/ci/UnityStubs) y ejecuta los tests EditMode
    con NUnit, igual que el Test Runner de Unity.
    Uso: dotnet test tools/ci/EditModeTests/Pacifico.EditMode.Tests.csproj
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Como Unity: los campos [SerializeField] se asignan desde el Inspector. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <!-- Ruta del Input System nuevo (el chequeo de compilación cubre la del Input Manager clásico). -->
    <DefineConstants>$(DefineConstants);ENABLE_INPUT_SYSTEM</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityAssets>$(MSBuildThisFileDirectory)../../../src/UnityProject/Assets</UnityAssets>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../UnityStubs/UnityEngineStubs.cs" LinkBase="UnityStubs" />
    <Compile Include="$(UnityAssets)/Scripts/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="$(UnityAssets)/Scripts/Runtime/**/*.cs" LinkBase="Runtime" />
    <Compile Include="$(UnityAssets)/Tests/EditMode/**/*.cs" LinkBase="Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
