<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Comprobación de compilación de Pacifico.Runtime y Pacifico.Editor contra
    stubs mínimos de la API de Unity (tools/ci/UnityStubs). No sustituye a
    compilar en el editor, pero detecta errores de sintaxis y de tipos.
    Uso: dotnet build tools/ci/UnityCompileCheck/Pacifico.Unity.CompileCheck.csproj
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Como Unity: los campos [SerializeField] se asignan desde el Inspector. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityAssets>$(MSBuildThisFileDirectory)../../../src/UnityProject/Assets</UnityAssets>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../UnityStubs/**/*.cs" LinkBase="UnityStubs" />
    <Compile Include="$(UnityAssets)/Scripts/**/*.cs" LinkBase="Scripts" />
  </ItemGroup>
</Project>
