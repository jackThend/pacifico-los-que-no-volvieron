<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Arnés de validación fuera de Unity: compila el ensamblado Pacifico.Core
    (noEngineReferences) y ejecuta los tests EditMode con NUnit.
    Uso: dotnet test tools/ci/CoreTests/Pacifico.Core.Tests.csproj
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityAssets>$(MSBuildThisFileDirectory)../../../src/UnityProject/Assets</UnityAssets>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityAssets)/Scripts/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="$(UnityAssets)/Tests/EditMode/**/*.cs" LinkBase="Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
