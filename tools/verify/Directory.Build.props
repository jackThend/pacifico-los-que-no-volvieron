<Project>
  <!--
    Arnés de verificación fuera del Editor de Unity.
    Compila las mismas fuentes de src/UnityProject/Assets con restricciones equivalentes a Unity 6:
    C# 9, .NET Standard 2.1, sin nullable, advertencias como errores.
  -->
  <PropertyGroup>
    <UnityAssets>$(MSBuildThisFileDirectory)../../src/UnityProject/Assets/</UnityAssets>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- Versión de las referencias de UnityEngine/UnityEditor usadas solo para verificar la compilación. -->
    <UnitySdkVersion>2021.1.14.1</UnitySdkVersion>
  </PropertyGroup>
</Project>
