<Project Sdk="Microsoft.NET.Sdk">
  <!-- Equivalente a Pacifico.Editor.asmdef (solo Editor). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Pacifico.Editor</AssemblyName>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_EDITOR_VERIFY</DefineConstants>
    <NoWarn>$(NoWarn);CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityAssets)Scripts/Editor/**/*.cs" />
    <ProjectReference Include="../Pacifico.Core/Pacifico.Core.csproj" />
    <ProjectReference Include="../Pacifico.Runtime/Pacifico.Runtime.csproj" />
    <PackageReference Include="Unity3D.SDK" Version="$(UnitySdkVersion)" ExcludeAssets="all" GeneratePathProperty="true" NoWarn="NU1701" />
    <Reference Include="UnityEngine">
      <HintPath>$(PkgUnity3D_SDK)/lib/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEditor">
      <HintPath>$(PkgUnity3D_SDK)/lib/UnityEditor.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
