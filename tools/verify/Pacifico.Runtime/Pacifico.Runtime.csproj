<Project Sdk="Microsoft.NET.Sdk">
  <!-- Equivalente a Pacifico.Runtime.asmdef: compila contra ensamblados de referencia de UnityEngine. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Pacifico.Runtime</AssemblyName>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR_VERIFY;ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <!-- CS1701/1702: unificación de mscorlib de las referencias de Unity (inofensivo). -->
    <NoWarn>$(NoWarn);CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityAssets)Scripts/Runtime/**/*.cs" />
    <ProjectReference Include="../Pacifico.Core/Pacifico.Core.csproj" />
    <PackageReference Include="Unity3D.SDK" Version="$(UnitySdkVersion)" ExcludeAssets="all" GeneratePathProperty="true" NoWarn="NU1701" />
    <Reference Include="UnityEngine">
      <HintPath>$(PkgUnity3D_SDK)/lib/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
